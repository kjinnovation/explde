\begin_layout Standard
\emph on
Newton-Cotes quadrature.
\emph default
 With equally spaced nodes including both endpoints (two nodes for order 2 and 
\begin_inset Formula $2n-1$
\end_inset
 nodes for order 
\begin_inset Formula $2n\ge4$
\end_inset
), the weights below are obtained by integrating the interpolating polynomial through the samples against 
\begin_inset Formula $P_k$
\end_inset
. Applying the Newton-Cotes rule to the product 
\begin_inset Formula $P_k\cdot A$
\end_inset
, as Blanes et al. do for their moments 
\begin_inset CommandInset citation
LatexCommand cite
key "bcr2000"
literal "false"
\end_inset
, 
\begin_inset CommandInset citation
LatexCommand cite
key "bcor2009"
literal "false"
\end_inset
, gives different weights for 
\begin_inset Formula $k\ge2$
\end_inset
; it is also a rule of polynomial degree 
\begin_inset Formula $2n-1$
\end_inset
 in the sense above, so it gives the same order, and on the test problems below the two choices agree in accuracy to within a few percent. The 
\begin_inset Formula $g_0$
\end_inset
 weights are the classical closed Newton-Cotes weights (trapezoid, Simpson, Boole and seven-point rules). With 
\begin_inset Formula $a_i$
\end_inset
 denoting the samples in node order,
\begin_inset Formula 
\begin{equation}
\begin{aligned}
&\text{Order 2 }(u=\pm1):\quad g_{0}=t\cdot(A(-t)+A(t))\\
&\text{Order 4 }(u=-1,0,1):\quad g_{0}=\tfrac{t}{3}\cdot(A(-t)+4\cdot A(0)+A(t)),\quad g_{1}=\tfrac{t}{3}\cdot(A(t)-A(-t))\\
&\text{Order 6 }(u=-1,-\tfrac{1}{2},0,\tfrac{1}{2},1):\\
&\quad g_{0}=\tfrac{t}{45}\cdot(7a_{0}+32a_{1}+12a_{2}+32a_{3}+7a_{4}),\quad g_{1}=\tfrac{t}{45}\cdot(-7a_{0}-16a_{1}+16a_{3}+7a_{4})\\
&\quad g_{2}=\tfrac{t}{315}\cdot(34a_{0}+32a_{1}-132a_{2}+32a_{3}+34a_{4})\\
&\text{Order 8 }(u=-1,-\tfrac{2}{3},-\tfrac{1}{3},0,\tfrac{1}{3},\tfrac{2}{3},1):\\
&\quad g_{0}=\tfrac{t}{420}\cdot(41a_{0}+216a_{1}+27a_{2}+272a_{3}+27a_{4}+216a_{5}+41a_{6})\\
&\quad g_{1}=\tfrac{t}{420}\cdot(-41a_{0}-144a_{1}-9a_{2}+9a_{4}+144a_{5}+41a_{6})\\
&\quad g_{2}=\tfrac{t}{2100}\cdot(163a_{0}+432a_{1}-675a_{2}+160a_{3}-675a_{4}+432a_{5}+163a_{6})\\
&\quad g_{3}=\tfrac{t}{140}\cdot(-9a_{0}+27a_{2}-27a_{4}+9a_{6})
\end{aligned}\label{eq:nc}
\end{equation}

\end_inset
The leading quadrature error of 
\begin_inset Formula $g_0$
\end_inset
, 
\begin_inset Formula $\int_{-t}^{t}A(\tau)\,d\tau-(\text{rule})=\kappa\cdot t^{2n+1}\cdot A^{(2n)}(0)$
\end_inset
, has the coefficients in Table 
\begin_inset CommandInset ref
LatexCommand ref
reference "tab:kappa"
plural "false"
caps "false"
noprefix "false"
\end_inset
,
\end_layout


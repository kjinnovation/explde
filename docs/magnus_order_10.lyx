\begin_layout Standard
\noindent
The Kronrod moments 
\begin_inset Formula $g_k=2t\cdot\sum_{i=1}^{7}w^K_i\cdot P_k(u_i)\cdot A(u_i\cdot t)$
\end_inset
 (
\begin_inset Formula $k=0,\ldots,4$
\end_inset
) are exact for polynomials of degree 11 and behave like exact moments here. The Gauss moments 
\begin_inset Formula $h_k=2t\cdot\sum w^G_i\cdot P_k(u_i)\cdot A(u_i\cdot t)$
\end_inset
 (
\begin_inset Formula $k=0,1,2$
\end_inset
, over the three Gauss nodes) are exact only to degree 5; in terms of exact moments,
\begin_inset Formula 
\begin{equation}
\begin{aligned}
h_{0}&=g_{0}-\tfrac{429}{100}g_{6}+\tfrac{2431}{800}g_{8}+\ldots\\
h_{1}&=g_{1}-\tfrac{99}{50}g_{5}-\tfrac{22}{25}g_{7}+\tfrac{2223}{1000}g_{9}+\ldots\\
h_{2}&=g_{2}-\tfrac{27}{20}g_{4}-\tfrac{91}{1000}g_{6}-\tfrac{5151}{8000}g_{8}+\ldots
\end{aligned}\label{eq:hexp}
\end{equation}

\end_inset
\end_layout

\begin_layout Standard
\emph on
Stage 1 (order 6).
\emph default
 From the Gauss samples alone, with three commutators,
\begin_inset Formula 
\begin{equation}
\begin{aligned}
D_{1}&=\big[\tfrac{1}{2}h_{0}+h_{2},\ h_{1}\big]\\
D_{2}&=\big[h_{2}+\tfrac{1}{5}D_{1},\ h_{0}+D_{1}\big]\\
D_{3}&=\big[3h_{0}+11h_{2}+D_{1},\ h_{1}-\tfrac{5}{54}D_{2}\big]\\
M_{6}&=h_{0}-\tfrac{14}{5}D_{1}+\tfrac{3}{10}D_{3}+O(t^{7})
\end{aligned}\label{eq:stage1}
\end{equation}

\end_inset
which is an order-6 formula in the Gauss moments, equivalent to Eq. 47 of 
\begin_inset CommandInset citation
LatexCommand cite
key "j28"
literal "false"
\end_inset
.
\end_layout

\begin_layout Standard
\emph on
Stage 2 (order 10).
\emph default
 Seven further commutators 
\begin_inset Formula $C_i=[X_i,Y_i]$
\end_inset
, 
\begin_inset Formula $i=4,\ldots,10$
\end_inset
, may use 
\begin_inset Formula $g_0,\ldots,g_4$
\end_inset
, 
\begin_inset Formula $h_0,h_1,h_2$
\end_inset
, 
\begin_inset Formula $D_1,D_2,D_3$
\end_inset
 and each other. Besides the 70 order conditions, they must cancel the terms containing 
\begin_inset Formula $g_5,\ldots,g_8$
\end_inset
 through weight 9 that enter through the 
\begin_inset Formula $h_k$
\end_inset
 (Eq. 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:hexp"
plural "false"
caps "false"
noprefix "false"
\end_inset
), which gives 78 conditions. With coefficients 
\begin_inset Formula $y_1,\ldots,y_{96}$
\end_inset
 (Appendix B), of which 35 are rational and 61 irrational,
\begin_inset Formula 
\begin{equation}
\begin{aligned}
X_{4}&=y_{1}h_{0}+y_{2}h_{2}\\
Y_{4}&=y_{3}g_{1}+y_{4}g_{3}+y_{5}h_{1}+y_{6}D_{2}\\
X_{5}&=y_{7}g_{4}+y_{8}h_{0}+y_{9}h_{2}+y_{10}D_{1}+y_{11}D_{3}+y_{12}C_{4}\\
Y_{5}&=y_{13}g_{1}+y_{14}g_{3}+y_{15}h_{1}\\
X_{6}&=y_{16}g_{2}+y_{17}g_{4}+y_{18}h_{0}+y_{19}h_{2}+y_{20}D_{1}+y_{21}D_{3}+y_{22}C_{4}\\
&\qquad+y_{23}C_{5}\\
Y_{6}&=y_{24}g_{0}+y_{25}g_{2}+y_{26}g_{4}+y_{27}h_{0}+y_{28}h_{2}+y_{29}D_{1}+y_{30}D_{3}\\
&\qquad+y_{31}C_{4}\\
X_{7}&=y_{32}g_{0}+y_{33}g_{4}+y_{34}h_{0}+y_{35}h_{2}+y_{36}D_{1}+y_{37}C_{4}\\
Y_{7}&=y_{38}g_{1}+y_{39}g_{3}+y_{40}h_{1}+y_{41}D_{2}+y_{42}C_{6}
\end{aligned}\label{eq:stage2}
\end{equation}

\end_inset

\begin_inset Formula 
\begin{equation}
\begin{aligned}
X_{8}&=y_{43}g_{0}+y_{44}g_{2}+y_{45}g_{4}+y_{46}h_{0}+y_{47}h_{2}+y_{48}C_{4}+y_{49}C_{7}\\
Y_{8}&=y_{50}g_{0}+y_{51}g_{2}+y_{52}g_{4}+y_{53}h_{0}+y_{54}h_{2}+y_{55}D_{3}+y_{56}C_{5}\\
&\qquad+y_{57}C_{7}\\
X_{9}&=y_{58}g_{2}+y_{59}g_{4}+y_{60}h_{0}+y_{61}h_{2}+y_{62}D_{1}+y_{63}D_{3}+y_{64}C_{4}\\
&\qquad+y_{65}C_{5}+y_{66}C_{7}\\
Y_{9}&=y_{67}g_{1}+y_{68}g_{3}+y_{69}h_{1}+y_{70}D_{2}+y_{71}C_{6}+y_{72}C_{8}\\
X_{10}&=y_{73}g_{0}+y_{74}g_{2}+y_{75}g_{4}+y_{76}h_{0}+y_{77}h_{2}+y_{78}D_{1}+y_{79}D_{3}\\
&\qquad+y_{80}C_{4}+y_{81}C_{5}+y_{82}C_{7}+y_{83}C_{9}\\
Y_{10}&=y_{84}g_{1}+y_{85}g_{3}+y_{86}h_{1}+y_{87}D_{2}+y_{88}C_{6}+y_{89}C_{8}\\
M_{10}&=g_{0}+y_{90}D_{1}+y_{91}D_{3}+y_{92}C_{4}+y_{93}C_{5}+y_{94}C_{7}+y_{95}C_{9}+y_{96}C_{10}+O(t^{11})
\end{aligned}\label{eq:stage2b}
\end{equation}

\end_inset
The large coefficients in 
\begin_inset Formula $C_8$
\end_inset
 multiply small combinations (
\begin_inset Formula $h_k-g_k$
\end_inset
 and 
\begin_inset Formula $g_4$
\end_inset
); this is how stage 2 cancels the quadrature errors of the Gauss moments. With six new commutators (nine in all) the generic Jacobian rank reaches only 76, and 67 Levenberg-Marquardt restarts stalled at residual 
\begin_inset Formula $1.1\times10^{-2}$
\end_inset
; seven new commutators give exact solutions. The nodes must be the Kronrod nodes: a seven-node rule containing the Gauss nodes and the endpoints, 
\begin_inset Formula $u=0,\pm\frac{1}{3},\pm\sqrt{3/5},\pm1$
\end_inset
, is exact to degree 9, which suffices for Eq. 
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:f10"
plural "false"
caps "false"
noprefix "false"
\end_inset
, but not for this pair, because stage 2 uses 
\begin_inset Formula $g_4$
\end_inset
 in weight-7 terms to cancel the 
\begin_inset Formula $g_4$
\end_inset
 component of 
\begin_inset Formula $h_2$
\end_inset
.
\end_layout

\begin_layout Standard
\emph on
Root polishing.
\emph default
 The 61 irrational coefficients were polished as above, with the 78 conditions taken on the Lyndon words in 
\begin_inset Formula $g_0,\ldots,g_8$
\end_inset
. The Jacobian (
\begin_inset Formula $78\times61$
\end_inset
) has full rank 61, so the solution is again isolated; its condition number is 
\begin_inset Formula $3.2\times10^{10}$
\end_inset
 (
\begin_inset Formula $1.9\times10^{8}$
\end_inset
 with column scaling). Starting from the coefficients rounded to 20 significant digits, the largest residual fell from 
\begin_inset Formula $10^{-18}$
\end_inset
 to 
\begin_inset Formula $10^{-36}$
\end_inset
, 
\begin_inset Formula $10^{-70}$
\end_inset
, 
\begin_inset Formula $10^{-139}$
\end_inset
 and 
\begin_inset Formula $10^{-208}$
\end_inset
 in successive iterations, and the polished values differ from the 20-digit values by less than 
\begin_inset Formula $4\times10^{-20}$
\end_inset
 relative.
\end_layout

